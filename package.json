{
  "name": "fkm-connector",
  "version": "1.0.0",
  "description": "Route C (Variant C3) - Production sheets to MRP service for Odoo, TypeScript implementation",
  "type": "module",
  "main": "dist/app.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "build:netlify": "tsc && node scripts/build-netlify.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  }
}
